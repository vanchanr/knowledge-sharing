        "type": 3
      },
      "seed": 372535,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795382372535,
      "link": null,
      "locked": false,
      "text": "\u2022 While OSI is the canonical conceptual model, TCP/IP is the practical architecture of the Internet.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "80c32dc8",
      "type": "text",
      "x": 524,
      "y": 571,
      "width": 620,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 372535,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795382372535,
      "link": null,
      "locked": false,
      "text": "\u2022 Senders encapsulate headers down the stack; receivers de-encapsulate headers up the stack.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    }
  ],
