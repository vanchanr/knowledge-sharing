      "updated": 1795382372535,
      "link": null,
      "locked": false,
      "text": "Practical Reality: The Internet Runs on TCP/IP",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "9300c212",
      "type": "text",
      "x": 524,
      "y": 556,
      "width": 620,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
