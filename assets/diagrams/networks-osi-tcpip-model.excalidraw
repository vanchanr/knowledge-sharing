      "isDeleted": false,
      "boundElements": null,
      "updated": 1795375540477,
      "link": null,
      "locked": false,
      "text": "\u2022 While OSI is the canonical conceptual model, TCP/IP is the practical architecture of the Internet.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "3767a16a",
      "type": "text",
      "x": 524,
      "y": 571,
      "width": 640,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
