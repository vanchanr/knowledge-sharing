      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 540478,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795375540478,
      "link": null,
      "locked": false,
      "text": "\u2022 Senders encapsulate headers down the stack; receivers de-encapsulate headers up the stack.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    }
