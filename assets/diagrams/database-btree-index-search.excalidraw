      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 950061,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795381950061,
      "link": null,
      "locked": false,
      "text": "\u2022 Covering Index Optimization: If all SELECT columns exist in index keys (e.g. SELECT ID), Table Heap lookup is completely bypassed.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
