      "isDeleted": false,
      "boundElements": null,
      "updated": 1795381950061,
      "link": null,
      "locked": false,
      "text": "\u2022 O(log N) tree traversal reads pages from disk buffer pool; 1 random pointer read retrieves physical row record from Table Heap.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "bd076d3f",
      "type": "text",
      "x": 84,
      "y": 554,
      "width": 1060,
      "height": 14,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
