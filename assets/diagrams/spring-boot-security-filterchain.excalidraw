      "isDeleted": false,
      "boundElements": null,
      "updated": 1795382927224,
      "link": null,
      "locked": false,
      "text": "\u2022 Short-Circuiting: If authentication fails, ExceptionTranslationFilter halts chain and returns 401 immediately.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    }
