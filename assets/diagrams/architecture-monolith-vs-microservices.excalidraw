      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379129813,
      "link": null,
      "locked": false,
      "text": "\u2022 Weaknesses:",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "47c85bcd",
      "type": "text",
      "x": 924,
      "y": 513,
      "width": 300,
      "height": 13,
