      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379129813,
      "link": null,
      "locked": false,
      "text": "  - High operational complexity (Kubernetes, OTel, CI/CD).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "38455c15",
      "type": "text",
      "x": 924,
      "y": 528,
      "width": 300,
      "height": 13,
      "angle": 0,
