      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379129813,
      "link": null,
      "locked": false,
      "text": "\u2022 Best For: Large engineering orgs (> 50-100 devs).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
