      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379129813,
      "link": null,
      "locked": false,
      "text": "  - Distributed data consistency (Sagas replace ACID).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "79a8e1b1",
      "type": "text",
      "x": 924,
      "y": 543,
      "width": 300,
