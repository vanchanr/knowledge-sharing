      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379129813,
      "link": null,
      "locked": false,
      "text": "  - Independent deployment cycles per autonomous squad.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "61c04570",
      "type": "text",
      "x": 924,
      "y": 468,
      "width": 300,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
