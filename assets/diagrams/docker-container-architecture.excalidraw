      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377074108,
      "link": null,
      "locked": false,
      "text": "\u2022 Zero Hypervisor Overhead: Sub-second startup, native CPU execution, dynamic RAM.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
