      "boundElements": null,
      "updated": 1795381765992,
      "link": null,
      "locked": false,
      "text": "\u2022 Randomized Election Timeouts (150ms - 300ms) prevent simultaneous candidate elections and split votes.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "3ce4f02f",
      "type": "text",
      "x": 94,
      "y": 264,
      "width": 1020,
      "height": 13,
      "angle": 0,
