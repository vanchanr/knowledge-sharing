        "type": 3
      },
      "seed": 765992,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795381765992,
      "link": null,
      "locked": false,
      "text": "\u2022 At most ONE leader can be elected per term; log completeness guarantees only nodes with all committed entries win election.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
