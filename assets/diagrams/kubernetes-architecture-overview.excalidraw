      "locked": false,
      "text": "Worker Node Architectural Invariants",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "48392abb",
      "type": "text",
      "x": 704,
      "y": 530,
      "width": 520,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 77765,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377077765,
      "link": null,
      "locked": false,
      "text": "\u2022 Pod Isolation: Pod is the atomic unit of scheduling; containers in a Pod co-exist on same node.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "1c541a5f",
      "type": "text",
      "x": 704,
      "y": 545,
      "width": 520,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 77765,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377077765,
      "link": null,
      "locked": false,
      "text": "\u2022 IP-per-Pod Model: Every Pod gets a unique cluster-routable IP; no port-mapping conflicts.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "c791e4ab",
      "type": "text",
      "x": 704,
      "y": 560,
      "width": 520,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 77765,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377077765,
      "link": null,
      "locked": false,
      "text": "\u2022 Decoupled Network: kube-proxy programs Linux kernel packet filters for instant L4 routing.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
