      "boundElements": null,
      "updated": 1795377077766,
      "link": null,
      "locked": false,
      "text": "Kubernetes Invariant: kube-apiserver is the single point of entry; nodes and controllers never communicate with etcd directly.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center"
    }
