      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377077765,
      "link": null,
      "locked": false,
      "text": "Containers communicate over localhost; share network IP, port space, and lifecycle",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
