    },
    {
      "id": "33a6ca63",
      "type": "text",
      "x": 84,
      "y": 489,
      "width": 460,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 77765,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377077765,
      "link": null,
      "locked": false,
      "text": "\u2022 Gatekeeper Rule: kube-apiserver is the ONLY component allowed to speak with etcd.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "dbc9e7e4",
      "type": "text",
      "x": 84,
      "y": 504,
      "width": 460,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 77765,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377077765,
      "link": null,
      "locked": false,
      "text": "\u2022 Declarative Reconciliation: Controllers poll desired state vs current state.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "d4ec97a2",
      "type": "text",
      "x": 84,
      "y": 519,
      "width": 460,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 77765,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377077765,
      "link": null,
      "locked": false,
      "text": "\u2022 Stateless Apiservers: All state lives in etcd; apiservers scale horizontally.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "baec065c",
      "type": "text",
      "x": 84,
      "y": 534,
      "width": 460,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 77765,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377077765,
      "link": null,
      "locked": false,
      "text": "\u2022 Concurrency: etcd uses resource revisions to prevent write collisions.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
