      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Training is Compute-Bound by matrix multiplies (FLOPs).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
