      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 673670,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Speculative Decoding: Draft model proposes k tokens;",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "a74822bb",
      "type": "text",
      "x": 788,
      "y": 537,
      "width": 424,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 673670,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "  Target LLM verifies in 1 forward pass (2-3x speedup).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "dbccb732",
      "type": "rectangle",
      "x": 770,
