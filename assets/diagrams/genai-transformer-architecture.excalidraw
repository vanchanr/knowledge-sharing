      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Tokens attend strictly to previous positions.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
