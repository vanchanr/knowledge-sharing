      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673669,
      "link": null,
      "locked": false,
      "text": "\u2022 Formula: Softmax((Q K^T / \u221ad_k) + M) * V",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
