      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Wall-Clock Speedup: 2-4x faster than standard PyTorch.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
