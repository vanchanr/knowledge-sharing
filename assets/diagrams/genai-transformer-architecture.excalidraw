      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Causal Mask M: Upper-triangular elements set to -\u221e.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "42d06ab2",
