      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673669,
      "link": null,
      "locked": false,
      "text": "\u2022 Prefill: Computes K & V for all prompt tokens in parallel.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "6584b073",
      "type": "text",
