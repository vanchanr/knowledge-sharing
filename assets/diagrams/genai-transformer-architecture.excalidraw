      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "1. Tensor Parallelism (TP: Intra-Node NVLink)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "533ccfa4",
      "type": "text",
      "x": 804,
      "y": 175,
      "width": 400,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 673670,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Splits weight matrices (QKV, MLP) across GPUs on same host.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "1ccfe7f8",
      "type": "text",
      "x": 804,
      "y": 190,
      "width": 400,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 673670,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Column-parallel -> Row-parallel with All-Reduce communication.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "d8307daa",
      "type": "text",
      "x": 804,
      "y": 205,
      "width": 400,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 673670,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Requires high-bandwidth (> 900 GB/s NVLink); latency sensitive.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "948b3c9a",
      "type": "rectangle",
      "x": 780,
      "y": 250,
      "width": 440,
      "height": 85,
      "angle": 0,
