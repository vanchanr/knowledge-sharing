      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673669,
      "link": null,
      "locked": false,
      "text": "\u2022 VRAM: 2 * 2 * layers * heads * dim * seq_len.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
