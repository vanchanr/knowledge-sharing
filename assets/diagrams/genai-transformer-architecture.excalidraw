      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "LLM Hardware Scaling Invariant",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "6dc77ff7",
      "type": "text",
