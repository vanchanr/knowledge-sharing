      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "4. Quantization & Speculative Decoding",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "9f96b67d",
      "type": "text",
      "x": 804,
      "y": 492,
      "width": 400,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 673670,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 Weight Quant (AWQ / GPTQ INT4): Shrinks 70B from 140GB to 35GB.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "807c86c8",
      "type": "text",
      "x": 804,
      "y": 507,
      "width": 400,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 673670,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673670,
      "link": null,
      "locked": false,
      "text": "\u2022 FP8 Execution: Uses Native FP8 tensor cores on Hopper GPUs.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "624b15f0",
      "type": "text",
      "x": 804,
      "y": 522,
      "width": 400,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
