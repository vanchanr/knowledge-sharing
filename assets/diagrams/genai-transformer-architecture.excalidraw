      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795378673669,
      "link": null,
      "locked": false,
      "text": "\u2022 Decode: Appends new token's K, V; avoids O(N\u00b2).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "93e8962a",
