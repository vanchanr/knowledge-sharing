      "boundElements": null,
      "updated": 1795373814613,
      "link": null,
      "locked": false,
      "text": "Minimal Key Remapping & Uniform Load Balancing",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "ff0ecc84",
      "type": "text",
      "x": 84,
      "y": 591,
      "width": 960,
      "height": 14,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 814613,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795373814613,
      "link": null,
      "locked": false,
      "text": "\u2022 Rebalancing Cost: When a node joins or leaves, only K/N keys are redistributed (traditional hash % N invalidates 100%).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "d572c87d",
      "type": "text",
      "x": 84,
      "y": 607,
      "width": 960,
      "height": 14,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 814613,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795373814613,
      "link": null,
      "locked": false,
      "text": "\u2022 Virtual Nodes (A1, A2... An): Prevents hot spots and guarantees uniform hash distribution across heterogeneous servers.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    }
  ],
