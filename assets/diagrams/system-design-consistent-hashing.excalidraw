      "isDeleted": false,
      "boundElements": null,
      "updated": 1795381440701,
      "link": null,
      "locked": false,
      "text": "\u2022 Rebalancing Cost: When a node joins or leaves, only K/N keys are redistributed (traditional hash % N invalidates 100% of cache keys).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
