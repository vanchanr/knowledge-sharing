      "isDeleted": false,
      "boundElements": null,
      "updated": 1795375162533,
      "link": null,
      "locked": false,
      "text": "\u2022 Forked Child Process: BGSAVE snapshotting and BGREWRITEAOF log compaction use Linux Copy-on-Write (CoW) memory pages.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    }
