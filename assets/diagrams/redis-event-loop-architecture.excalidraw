      "isDeleted": false,
      "boundElements": null,
      "updated": 1795375162533,
      "link": null,
      "locked": false,
      "text": "\u2022 BIO Threads: Socket network reads/writes, AOF fsync flushes, and UNLINK lazy-freeing large keys run on background threads.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "5b64d7d6",
      "type": "text",
      "x": 84,
