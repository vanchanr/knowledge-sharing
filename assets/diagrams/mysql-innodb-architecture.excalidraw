      "isDeleted": false,
      "boundElements": null,
      "updated": 1795380057313,
      "link": null,
      "locked": false,
      "text": "  yielding O(1) in-memory point reads.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
