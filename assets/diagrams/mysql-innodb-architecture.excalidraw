      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795380057313,
      "link": null,
      "locked": false,
      "text": "\u2022 Auto-built for hot index pages.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "87b80d16",
      "type": "text",
