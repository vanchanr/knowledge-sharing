      "updated": 1795380057314,
      "link": null,
      "locked": false,
      "text": "Crash Recovery: If MySQL crashes, InnoDB replays Redo Logs up to the latest LSN checkpoint and uses Undo Logs to roll back uncommitted transactions.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
