      "isDeleted": false,
      "boundElements": null,
      "updated": 1795380057313,
      "link": null,
      "locked": false,
      "text": "\u2022 Bypasses B-tree root-to-leaf path",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
