      "isDeleted": false,
      "boundElements": null,
      "updated": 1795380057313,
      "link": null,
      "locked": false,
      "text": "\u2022 Buffers secondary index writes.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
