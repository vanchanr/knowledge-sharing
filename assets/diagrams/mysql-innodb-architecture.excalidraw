      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795380057313,
      "link": null,
      "locked": false,
      "text": "In-Memory Invariant: Updates modify pages in the Buffer Pool and append to the Redo Log Buffer in RAM. Pages become 'dirty' and are lazily flushed to disk via background checkpoint threads.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
