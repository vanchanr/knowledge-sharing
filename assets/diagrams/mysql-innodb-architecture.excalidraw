      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795380057313,
      "link": null,
      "locked": false,
      "text": "\u2022 In-memory hash lookup for B-tree.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
