      "link": null,
      "locked": false,
      "text": "Kernel Architectural Invariants",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "1b3b91de",
      "type": "text",
      "x": 84,
      "y": 515,
      "width": 1120,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 598788,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379598788,
      "link": null,
      "locked": false,
      "text": "\u2022 Ring 0 Privilege: Monolithic kernel code executes with full CPU hardware privileges.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "539715d9",
      "type": "text",
      "x": 84,
      "y": 530,
      "width": 1120,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 598788,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379598788,
      "link": null,
      "locked": false,
      "text": "\u2022 Fault Isolation: A crash in user space kills only the process; a crash in Ring 0 triggers a Kernel Panic.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "fa06957c",
      "type": "text",
      "x": 84,
      "y": 545,
      "width": 1120,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 598788,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379598788,
      "link": null,
      "locked": false,
      "text": "\u2022 Virtual Memory: User space processes cannot read or write to kernel memory addresses (KPTI).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
