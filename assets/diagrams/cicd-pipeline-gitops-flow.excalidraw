      "updated": 1795377495973,
      "link": null,
      "locked": false,
      "text": "\u2022 Pull Model: Operator inside cluster pulls configs; NO inbound firewall holes required.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
