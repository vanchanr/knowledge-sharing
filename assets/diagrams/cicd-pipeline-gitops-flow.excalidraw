      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377495972,
      "link": null,
      "locked": false,
      "text": "\u2022 Shift-Left Security: Block PR merge immediately if SAST, secrets, or CVE scans fail.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "7dd02041",
      "type": "text",
      "x": 84,
      "y": 428,
      "width": 510,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 495972,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377495972,
      "link": null,
      "locked": false,
      "text": "\u2022 Ephemeral Runners: Every workflow executes in isolated, single-use container runners.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "bdaa352a",
      "type": "text",
      "x": 84,
      "y": 443,
      "width": 510,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 495972,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377495972,
      "link": null,
      "locked": false,
      "text": "\u2022 Reproducibility: Strict dependency lockfiles (pom.xml, yarn.lock, go.sum) enforce builds.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "f8b4fb82",
      "type": "text",
      "x": 84,
      "y": 458,
      "width": 510,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 495972,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377495972,
      "link": null,
      "locked": false,
      "text": "\u2022 Speed Optimization: Heavy layer caching via GitHub Actions cache or registry caches.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "038a42a6",
      "type": "text",
      "x": 84,
      "y": 473,
      "width": 510,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
