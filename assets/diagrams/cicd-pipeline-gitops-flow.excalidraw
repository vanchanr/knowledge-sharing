      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795377495972,
      "link": null,
      "locked": false,
      "text": "\u2022 Blast Radius Containment: CI runners never have direct write credentials to production K8s.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
