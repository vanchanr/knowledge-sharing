      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "\u2022 Private Feature Branches: Rebase and squash local commits to create clean, reviewable PRs.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "f9a943d7",
      "type": "text",
      "x": 84,
      "y": 600,
      "width": 1120,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602370,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "\u2022 Public / Production Branches: Always use Merge to preserve genuine timeline and audit trail.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "3bfc0d4c",
      "type": "text",
      "x": 84,
      "y": 615,
      "width": 1120,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602370,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "\u2022 Fast-Forward: If main has not diverged, git merge simply moves the branch pointer forward.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
