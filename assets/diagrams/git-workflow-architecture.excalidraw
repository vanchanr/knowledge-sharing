      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "Golden Rule of Rebase & Collaboration",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "8056705d",
      "type": "text",
