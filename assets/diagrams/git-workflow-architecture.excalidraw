      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602369,
      "link": null,
      "locked": false,
      "text": "git merge feature (3-Way Merge Commit)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "40467be9",
      "type": "text",
      "x": 84,
      "y": 451,
      "width": 520,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602369,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602369,
      "link": null,
      "locked": false,
      "text": "\u2022 Graph Topology: Preserves complete historical branch graph as it actually happened.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "4163b095",
      "type": "text",
      "x": 84,
      "y": 466,
      "width": 520,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602369,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602369,
      "link": null,
      "locked": false,
      "text": "\u2022 3-Way Merge: Compares Base Ancestor (C0) with Main Tip (M2) and Feature Tip (F2).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "aab2a959",
      "type": "text",
      "x": 84,
      "y": 481,
      "width": 520,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602370,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "\u2022 Merge Commit (M3): Generates a new commit with TWO parents (Parent 1: M2, Parent 2: F2).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "e89cc844",
      "type": "text",
      "x": 84,
      "y": 496,
      "width": 520,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602370,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "\u2022 Invariant: Completely non-destructive. Commit hashes are never rewritten or altered.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "b7830a69",
      "type": "text",
      "x": 84,
      "y": 511,
      "width": 520,
