      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "Core Git Philosophy: Git is an immutable, content-addressable key-value store (DAG) masked by a familiar version control command line.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center"
    }
