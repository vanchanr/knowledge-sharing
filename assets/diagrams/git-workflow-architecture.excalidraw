      "locked": false,
      "text": "Git Object Model Invariant",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "83b79c4c",
      "type": "text",
      "x": 84,
      "y": 285,
      "width": 1120,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602369,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602369,
      "link": null,
      "locked": false,
      "text": "\u2022 Blobs: Store file contents. Trees: Store directory listings and filenames pointing to blobs.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "c6c355e3",
      "type": "text",
      "x": 84,
      "y": 300,
      "width": 1120,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602369,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602369,
      "link": null,
      "locked": false,
      "text": "\u2022 Commits: Point to a top-level Tree object, author/committer metadata, and parent commit SHAs.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "459bfcd3",
      "type": "text",
      "x": 84,
      "y": 315,
      "width": 1120,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602369,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602369,
      "link": null,
      "locked": false,
      "text": "\u2022 Branches: Lightweight movable pointers (41 bytes: 40-char SHA + newline) in .git/refs/heads/.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
