      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "Replays Feature Commits on Tip of Main",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "e4abc3a9",
      "type": "text",
      "x": 704,
      "y": 472,
      "width": 480,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602370,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "\u2022 Unwinds feature commits and fast-forwards feature base to latest Main commit (M2).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "01b44c49",
      "type": "text",
      "x": 704,
      "y": 487,
      "width": 480,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602370,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "\u2022 Re-applies changes as brand new commits (F1', F2') with NEW SHA hashes.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "0d0333af",
      "type": "text",
      "x": 704,
      "y": 502,
      "width": 480,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 602370,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795379602370,
      "link": null,
      "locked": false,
      "text": "\u2022 Linear Graph: Produces a clean, single line of commit history without merge bubbles.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "55d79ed3",
      "type": "text",
      "x": 704,
      "y": 517,
      "width": 480,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
