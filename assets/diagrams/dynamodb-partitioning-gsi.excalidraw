      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Overloading generic PK and SK attributes models complex relational graphs in a single DynamoDB table.",
      "fontSize": 11,
