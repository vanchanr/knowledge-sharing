      "locked": false,
      "text": "GSI Inverted Index Table: { PK: 'Status#PAID', SK: '2026-01-15' }",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "ed3459a8",
      "type": "text",
      "x": 704,
      "y": 273,
      "width": 440,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
