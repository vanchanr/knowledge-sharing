      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Projected Attributes: Total, OrderId (INCLUDE or ALL projections)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
