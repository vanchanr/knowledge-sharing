      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Partition Key (PK): Passed through MD5 hash to find physical partition node.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "cbc656b7",
      "type": "text",
      "x": 84,
      "y": 427,
      "width": 430,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
