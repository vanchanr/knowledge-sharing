      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Sort Key (SK): Organizes items into contiguous local B-Tree pages on SSD.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "9bc18cc1",
      "type": "text",
      "x": 84,
      "y": 442,
      "width": 430,
      "height": 13,
      "angle": 0,
