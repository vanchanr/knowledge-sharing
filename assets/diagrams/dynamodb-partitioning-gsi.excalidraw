      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "  SK supports range queries (begins_with, between, >, <).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
