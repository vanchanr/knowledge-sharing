      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "GSI Architectural Trade-offs",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "426e18c2",
      "type": "text",
      "x": 704,
      "y": 412,
      "width": 440,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 458840,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Eventual Consistency: GSI updates are asynchronous (typically < 10ms).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "5613e6ad",
      "type": "text",
      "x": 704,
      "y": 427,
      "width": 440,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 458840,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Dedicated Capacity: GSIs maintain their own provisioned RCU / WCU.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "5152a397",
      "type": "text",
      "x": 688,
      "y": 442,
      "width": 464,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 458840,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "  Throttling the GSI will throttle base table writes!",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "87290345",
      "type": "text",
      "x": 704,
      "y": 457,
      "width": 440,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 458840,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Single-Table Design: Enables querying across heterogeneous entity types.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
