      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Inverted Partition Key: Queries all orders by Status (avoids full table scan)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "a6d0fd16",
      "type": "text",
      "x": 704,
      "y": 288,
      "width": 440,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 458840,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376458840,
      "link": null,
      "locked": false,
      "text": "\u2022 Inverted Sort Key: CreatedAt timestamp enables chronological range queries",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "f269dbc7",
      "type": "text",
