      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376808594,
      "link": null,
      "locked": false,
      "text": "\u2022 Strict ordering is guaranteed ONLY within a single partition.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "f78e544a",
      "type": "text",
      "x": 314,
      "y": 444,
      "width": 400,
      "height": 13,
      "angle": 0,
