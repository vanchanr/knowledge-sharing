      },
      "seed": 808594,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376808594,
      "link": null,
      "locked": false,
      "text": "\u2022 Records with the same partition key always land on the same partition.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
