      "updated": 1795376808594,
      "link": null,
      "locked": false,
      "text": "Zero-Copy Streaming & Consumer Group Isolation",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "710e9713",
      "type": "text",
      "x": 84,
      "y": 571,
      "width": 1040,
      "height": 14,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 808594,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376808594,
      "link": null,
      "locked": false,
      "text": "\u2022 Multiple Independent Consumer Groups: Different groups ('analytics', 'inventory') read from the same topic simultaneously at their own offset pace.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "02a2e5c7",
      "type": "text",
      "x": 84,
      "y": 587,
      "width": 1040,
      "height": 14,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 808594,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376808594,
      "link": null,
      "locked": false,
      "text": "\u2022 Linux Zero-Copy: Uses sendfile() system call to stream partition data directly from OS PageCache to network NIC, bypassing JVM heap.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    }
