        "type": 3
      },
      "seed": 824401,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795368824401,
      "link": null,
      "locked": false,
      "text": "\u2022 Multiple independent consumer groups read from the same topic at their own pace without competing.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left"
    }
