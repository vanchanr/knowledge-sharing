      "text": " Ordering & Concurrency Guarantees ",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "b5415181",
      "type": "text",
      "x": 60,
      "y": 405,
      "width": 800,
      "height": 24,
      "angle": 0,
      "strokeColor": "#0ca678",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 824401,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795368824401,
      "link": null,
      "locked": false,
      "text": "\u2022 A single partition is consumed by AT MOST ONE consumer instance in a group (guarantees per-partition ordering).",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "a963d96e",
      "type": "text",
      "x": 60,
      "y": 425,
      "width": 800,
      "height": 24,
      "angle": 0,
