      "updated": 1795376122393,
      "link": null,
      "locked": false,
      "text": "Spring MVC Architectural Principles",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center"
    },
    {
      "id": "4a271f8f",
      "type": "text",
      "x": 64,
      "y": 505,
      "width": 1020,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 122393,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376122393,
      "link": null,
      "locked": false,
      "text": "\u2022 Front Controller Pattern: A single centralized servlet (DispatcherServlet) manages the entire request-response lifecycle.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "adfd2933",
      "type": "text",
      "x": 64,
      "y": 520,
      "width": 1020,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 122393,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376122393,
      "link": null,
      "locked": false,
      "text": "\u2022 Separation of Concerns: HandlerMapping resolves routes, HandlerAdapter executes methods, and HttpMessageConverter serializes payloads.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    },
    {
      "id": "5cf47cf8",
      "type": "text",
      "x": 64,
      "y": 535,
      "width": 1020,
      "height": 13,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 122393,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795376122393,
      "link": null,
      "locked": false,
      "text": "\u2022 View Resolution vs REST: In @RestController, @ResponseBody signals Jackson to write directly into response stream, bypassing ViewResolvers.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left"
    }
  ],
